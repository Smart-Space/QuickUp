<tinui>
<!-- QuickUp Editor -->
<line x="0">
    <line padx="5">
        <entry width="302">entry</entry>
        <togglebutton text="&#xE7B3;" font="{Segoe Fluent Icons} 16" command="self.funcs['if_hide_task']">hidebutton</togglebutton>
        <line x='495' padx='5' anchor="w" lineanchor='ne'>
            <toolbutton icon="&#xE74E;" text="" font="{Segoe Fluent Icons} 16" command="self.funcs['save_task']"></toolbutton>
            <toolbutton icon="&#xE724;" text="" font="{Segoe Fluent Icons} 16" command="self.funcs['run_task']"></toolbutton>
            <toolbutton icon="&#xE8B7;" text="" font="{Segoe Fluent Icons} 16" command="self.funcs['set_cwd']"></toolbutton>
        </line>
    </line>
    <line padx="5" x="5" anchor="w" lineanchor="nw">
        <button2 text="命令" command="self.funcs['add_task_cmd']"></button2>
        <button2 text="命令集" command="self.funcs['add_task_cmds']"></button2>
        <button2 text="子任务" command="self.funcs['add_task_task']"></button2>
        <button2 text="工作区" command="self.funcs['add_workspace']"></button2>
        <button2 text="" icon="&#xE70B;" font="{Segoe Fluent Icons} 16" command="self.funcs['add_tip']"></button2>
        <button2 text="" icon="&#xEA86;" font="{Segoe Fluent Icons} 16" command="self.funcs['add_plugin']"></button2>
        <button2 text="" icon='&#xE7C8;' font="{Segoe Fluent Icons} 16" command="self.funcs['record_apps']"></button2>
        <line x='495' padx='5' lineanchor='e'>
            <togglebutton text="&#xE734;" font="{Segoe Fluent Icons} 16" command="self.funcs['set_priority']">ratingbar</togglebutton>
            <toolbutton icon="&#xE8DA;" text="" font="{Segoe Fluent Icons} 16" command="self.funcs['open_local']"></toolbutton>
            <toolbutton icon="&#xEE49;" text="" font="{Segoe Fluent Icons} 16" command="self.funcs['create_task_lnk']"></toolbutton>
        </line>
    </line>
</line>
<line pady="-10">
    <labels command="self.funcs['add_label']">labels</labels>
</line>
<line x="-3">
    <listview width="480" height="500" num="0" linew="100" command="self.funcs['select_task']">view</listview>
</line>
</tinui>
